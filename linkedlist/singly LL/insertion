import java.util.LinkedList;
import java.util.Scanner;
class single
{
    public static void main(String args[])
    {
      LinkedList<String>l=new LinkedList<String>();
      l.add("sim");
      l.add("SIM");
      l.add("bishnoi");
      l.add(0,"miss");  //insertion at start
      l.remove(0);       //deletion of head
      System.out.println(l.size());   //length of LL
      
      System.out.println(l);
      Scanner sc=new Scanner(System.in);
      String target=sc.nextLine();
      
      System.out.println(search(l,target));

        sc.close();
      
    }
    public static int search(LinkedList <String>l,String target){
      for(int i=0;i<l.size();i++){
        if(target.equals(l.get(i))){       //don't use ==
          return i;
        }
        else continue;
      }
      return -1;
    }
}
