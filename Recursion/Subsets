//used bit manipulation ,bitmask 3 1 2 ,picking not picking 000,001,100,010,110,011,101,111
class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> result=new ArrayList<>();
        int n=nums.length;
        for(int mask=0;mask<(1<<n);mask++)
        {
            List<Integer>subset=new ArrayList<>();
            for(int i=0;i<n;i++){
                if((mask &(1<<i))!=0){
                    subset.add(nums[i]);
                }
            }
            result.add(subset);
        }
        return result;
    }
}
