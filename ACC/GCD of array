//gcd of array is gcd(gcd(a,b),c)...
class Solution {
    static int gcd(int a,int b){
        if(a==0)return b;
        return gcd(b%a,a);
    }
    public int findGCD(int[] nums) {
        int res=nums[0];//not 1
        for(int i=1;i<nums.length;i++){//start from 2nd element
        res=gcd(res,nums[i]);
        }
        return res;
    }
}
