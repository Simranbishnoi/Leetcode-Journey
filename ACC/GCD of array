//gcd of array is gcd(gcd(a,b),c)...
class Solution {
    static int gcd(int a,int b){
        if(a==0)return b;
        return gcd(b%a,a);
    }
    public int findGCD(int[] nums) {
        int res=1;
        for(int i=0;i<nums.length;i++){
        res=gcd(res,nums[i]);
        }
        return res;
    }
}
