class Solution {
    public int countPrimes(int n) {
        boolean primes[]=new boolean[n+1];
        for(int i=2;i<=n;i++){
            primes[i]=true;
        }
        for(int p=2;p*p<=n;p++){
            if(primes[p]==true)
            {
                for(int i=p*p;i<=n;i+=p){
                    primes[i]=false;
                }
            }
        }
        int count=0;
        for(int i=2;i<=n;i++){
            if(primes[i]==true)
  count++;

        }
        return count;
    }
}
