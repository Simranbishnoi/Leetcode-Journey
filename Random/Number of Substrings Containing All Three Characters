//Brute force using HashSet which have only unique elements 
class Solution {
    public int numberOfSubstrings(String s) {
        int n=s.length();
        int subCount=0;
        for(int i=0;i<n;i++){
            HashSet<Character> set=new HashSet<>();
            for(int j=i;j<n;j++){
                set.add(s.charAt(j));
                if(set.size()==3)subCount++;
            }
        }
        return subCount;
    }
}
