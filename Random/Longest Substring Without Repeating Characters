//analyzed the pattern of variable window size (longest keyword) ,duplicate repeating (HashMap)
class Solution {
    public int lengthOfLongestSubstring(String s) {
        int L=0;
        int R=0;
        int n=s.length();
        HashMap<Character,Integer>map=new HashMap<>();
        int maxLength=1;
        if(n==0)return 0;
        if(n==1)
        return maxLength;
        while(R<n){
            if(!map.containsKey(s.charAt(R))){
                map.put(s.charAt(R),R);
            }
            else{
                int j;
                j=map.get(s.charAt(R));
                if(j>=L)
                L=j+1;
                map.put(s.charAt(R),R);
            }
            R++;
            if(maxLength<R-L)
            maxLength=R-L;
        }
        return maxLength;
    }

}
