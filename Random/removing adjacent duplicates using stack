class Solution {
    public String removeDuplicates(String s) {

        // write your code
        StringBuilder s1=new StringBuilder();
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(s1.length()>0 && s1.charAt(s1.length()-1)==c)
                s1.deleteCharAt(s1.length()-1);
            else
                s1.append(c);
        }
        return s1.toString();
    }
}
