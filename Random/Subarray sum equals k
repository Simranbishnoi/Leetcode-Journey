
//won't work if array contains negative so always see constraints 
class Solution {
    public int subarraySum(int[] nums, int k) {
        int n=nums.length;
        int i=0;
        int j=0;
        int sum=0;
        int count=0;
        while(j<n)
        {
            sum+=nums[j];
          //keep shrinking until become valid
            while(sum>k){
                sum-=nums[i];
                i++;
            }
            if(sum==k){
                count++;
            }
          //incre window 
            j++;
        }
        return count;
    }
}

// prefix+hashMap we have to use here
class Solution {
    public int subarraySum(int[] nums, int k) {
        int n=nums.length;
       HashMap<Integer,Integer>map=new HashMap<>();
       map.put(0,1);
       int prefSum=0;
       int count=0;
       for(int i=0;i<n;i++){
        prefSum+=nums[i];
        int remove=prefSum-k;
        count+=map.getOrDefault(remove,0);
        map.put(prefSum,map.getOrDefault(prefSum,0)+1);
       }
       return count;
    }
}
