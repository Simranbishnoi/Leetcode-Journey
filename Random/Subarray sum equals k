class Solution {
    public int subarraySum(int[] nums, int k) {
        int n=nums.length;
        int i=0;
        int j=0;
        int sum=0;
        int count=0;
        while(j<n)
        {
            sum+=nums[j];
          //keep shrinking until become valid
            while(sum>k){
                sum-=nums[i];
                i++;
            }
            if(sum==k){
                count++;
            }
          //incre window 
            j++;
        }
        return count;
    }
}
//won't work if array contains negative so always see constraints 
