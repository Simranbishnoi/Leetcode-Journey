//using substring and thinking that rotation is increasing by 1,2,3 substring so using for loop for it's indication and then substring on i basis 
class Solution {
    public int countRotations(String s, int k) {
        int n=s.length();
        int ans=0;
        for(int i=0;i<n;i++){//number of substring char for rotation 
            int score=0;
            String rotated=s.substring(i)+s.substring(0,i);
            for(int j=0;j<n-1;j++){
                if(rotated.charAt(j)==rotated.charAt(j+1))score++;
            }
            if(score==k)ans++;
        }
     return ans;   
    }
}
