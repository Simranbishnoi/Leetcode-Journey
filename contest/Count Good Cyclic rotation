//not optimsed N^2 time complexity
class Solution {
    public int countGoodRotations(int[] nums) {

        int n = nums.length;
        int count = 0;

        for (int i = 0; i < n; i++) {

            int[] rotated = new int[n];
            for (int j = 0; j < n; j++) {
                rotated[j] = nums[(j + i) % n];
            }

            int sumFirst = 0;
            int sumLast = 0;
            for (int j = 0; j < n / 2; j++) {
                sumFirst += rotated[j];
            }
            for (int j = n / 2; j < n; j++) {
                sumLast += rotated[j];
            }

            if (sumFirst > sumLast) {
                count++;
            }
        }

        return count;
    }
}
//optimisd using sliding fixed sized window with just basic thinking what to add what to subtract
//one edge case of thinking long instead of declaring int 
class Solution {
    public int countGoodRotations(int[] nums) {

        int n = nums.length;
        int half = n / 2;

        long sumF = 0;
        long sumL = 0;
        int count = 0;

        for (int i = 0; i < half; i++) {
            sumF += nums[i];
        }

        for (int i = half; i < n; i++) {
            sumL += nums[i];
        }

        for (int i = 0; i < n; i++) {

            if (sumF > sumL) {
                count++;
            }


            sumF = sumF - nums[i]+ nums[(i + half) % n];
            sumL = sumL - nums[(i + half) % n]+ nums[i];
        }

        return count;
    }
}
