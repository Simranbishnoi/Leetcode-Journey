//not optimsed N^2 time complexity
class Solution {
    public int countGoodRotations(int[] nums) {

        int n = nums.length;
        int count = 0;

        for (int i = 0; i < n; i++) {

            int[] rotated = new int[n];
            for (int j = 0; j < n; j++) {
                rotated[j] = nums[(j + i) % n];
            }

            int sumFirst = 0;
            int sumLast = 0;
            for (int j = 0; j < n / 2; j++) {
                sumFirst += rotated[j];
            }
            for (int j = n / 2; j < n; j++) {
                sumLast += rotated[j];
            }

            if (sumFirst > sumLast) {
                count++;
            }
        }

        return count;
    }
}
